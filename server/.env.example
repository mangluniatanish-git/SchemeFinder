# SchemeFinder Server — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Frontend origin (used for CORS). Set to your deployed frontend URL in production.
CLIENT_ORIGIN=http://localhost:5173

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# MANUAL CONFIGURATION REQUIRED
# Without this, the server runs in DEMO MODE with seed data only.
# Get a free cluster at https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/schemefinder?retryWrites=true&w=majority

# ─── JWT Authentication ───────────────────────────────────────────────────────
# MANUAL CONFIGURATION REQUIRED
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ─── AI Provider ─────────────────────────────────────────────────────────────
# MANUAL CONFIGURATION REQUIRED
# Choose ONE provider and fill in its values.
# Without this, the server uses rule-based mock profile extraction.

# Option A: Google Gemini (recommended — generous free tier)
AI_PROVIDER=gemini
AI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Option B: OpenAI
# AI_PROVIDER=openai
# AI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# Option C: Anthropic Claude
# AI_PROVIDER=anthropic
# AI_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_API_KEY
# AI_MODEL=claude-3-haiku-20240307
# AI_BASE_URL=https://api.anthropic.com/v1

# ─── Optional: Notifications (for Scheme Radar) ───────────────────────────────
# MANUAL CONFIGURATION REQUIRED (only if implementing Scheme Radar alerts)

# Email (SMTP via nodemailer)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM=noreply@schemefinder.in

# WhatsApp / SMS (Twilio)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
