# =============================================================================
# SCHEMEFINDER — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# FRONTEND (Vite)
# -----------------------------------------------------------------------------
# Public — safe to expose to browser
VITE_API_BASE_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# BACKEND
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# -----------------------------------------------------------------------------
# DATABASE — MANUAL CONFIGURATION REQUIRED
# -----------------------------------------------------------------------------
# Obtain your MongoDB connection string from MongoDB Atlas or your self-hosted
# MongoDB instance.
# Without this, the server runs in DEMO MODE using local seed data.
# Example: mongodb+srv://username:password@cluster.mongodb.net/schemefinder
MONGODB_URI=

# -----------------------------------------------------------------------------
# AUTHENTICATION — MANUAL CONFIGURATION REQUIRED
# -----------------------------------------------------------------------------
# Generate a strong random secret. Example:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Without this, auth routes will return 503.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# AI / NLP — MANUAL CONFIGURATION REQUIRED
# -----------------------------------------------------------------------------
# Choose ONE AI provider. The server auto-detects from AI_PROVIDER.
# Without this, profile extraction uses rule-based parsing (always works).
#
# AI_PROVIDER options: gemini | openai | anthropic
AI_PROVIDER=

# --- Google Gemini ---
# API Key from: https://aistudio.google.com/app/apikey
# Recommended model: gemini-1.5-flash (fast, free tier available)
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- OpenAI (alternative) ---
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# --- Anthropic Claude (alternative) ---
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-3-haiku-20240307
# AI_BASE_URL=https://api.anthropic.com/v1

# -----------------------------------------------------------------------------
# CV PARSING — MANUAL CONFIGURATION REQUIRED (npm packages)
# -----------------------------------------------------------------------------
# After installing: npm install pdf-parse mammoth
# Uncomment CV extraction code in server/routes/profile.js
# No additional API keys needed — runs locally.

# -----------------------------------------------------------------------------
# EMAIL NOTIFICATIONS — MANUAL CONFIGURATION REQUIRED
# -----------------------------------------------------------------------------
# Required only for email scheme alerts. Leave blank to disable.
# Supported providers: resend | sendgrid | nodemailer-smtp
EMAIL_PROVIDER=
EMAIL_FROM=

# --- Resend (recommended) ---
# https://resend.com
# EMAIL_API_KEY=re_...

# --- SendGrid ---
# EMAIL_API_KEY=SG...

# --- SMTP (Nodemailer) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# -----------------------------------------------------------------------------
# WHATSAPP NOTIFICATIONS — MANUAL CONFIGURATION REQUIRED
# -----------------------------------------------------------------------------
# Required only for WhatsApp scheme alerts.
# Requires Meta WhatsApp Business API access.
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Approved message template name for scheme alerts:
WHATSAPP_TEMPLATE_NAME=

# -----------------------------------------------------------------------------
# PUSH NOTIFICATIONS — MANUAL CONFIGURATION REQUIRED
# -----------------------------------------------------------------------------
# Required only for browser push notifications.
# Generate VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@schemefinder.in

# -----------------------------------------------------------------------------
# OAUTH — MANUAL CONFIGURATION REQUIRED
# -----------------------------------------------------------------------------
# Required only if adding Google Sign-In.
# Create credentials at: https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# -----------------------------------------------------------------------------
# FILE UPLOAD
# -----------------------------------------------------------------------------
# Maximum CV file size in bytes (default 5MB)
MAX_FILE_SIZE=5242880
# Allowed MIME types (comma-separated)
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# -----------------------------------------------------------------------------
# SCHEME RADAR / CRON — MANUAL CONFIGURATION REQUIRED
# -----------------------------------------------------------------------------
# Scheme Radar requires monitoring official sources.
# See INTEGRATION_SETUP.md for full setup.
# Cron schedule for checking updates (default: every 6 hours)
SCHEME_RADAR_CRON=0 */6 * * *

# -----------------------------------------------------------------------------
# FRONTEND PUBLIC URL (for CORS and callbacks)
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=10
